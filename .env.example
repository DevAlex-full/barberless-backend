# Ambiente
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Banco de dados (Supabase PostgreSQL)
# Não adicione `sslmode=...` na query string: o TLS é configurado
# programaticamente pela fábrica compartilhada
# (src/shared/prisma/createPrismaAdapter.ts), e um `sslmode` na URL pode
# gerar avisos de configuração conflitante no driver `pg`. A conexão
# continua usando TLS de qualquer forma.
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/database?schema=public"

# CORS (origens permitidas, separadas por vírgula)
CORS_ORIGIN="http://localhost:3000"

# Rate limit
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Documentação
SWAGGER_ENABLED=true

# Log
LOG_LEVEL=info
